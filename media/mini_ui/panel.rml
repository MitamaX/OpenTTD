<template name="panel" content="sheet">
<head>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="panel.rcss"/>
</head>
<body>
	<handle class="caption" move_target="#document" data-class-editing="editing == 'title'">
		<input type="text" class="edit" data-value="draft" data-event-change="commit('title')" data-event-blur="cancel('title')"/>
		<span class="title" data-event-dblclick="edit_title">{{title}}</span>
		<span class="close press" data-event-click="close"><svg class="icon" src="icons/close.svg"/></span>
	</handle>
	<div class="tabs" data-if="tabs.size > 0">
		<span class="tab press" data-for="name, index : tabs" data-class-active="index == tab" data-event-click="tab = index">{{name}}</span>
	</div>
	<div id="sheet" class="sheet" data-class-embedding="embedded"></div>
	<div class="commands" data-if="commands.size > 0">
		<span class="command press" data-for="command, index : commands" data-class-off="!command.enabled" data-class-active="command.active" data-event-click="run(index)">{{command.label}}</span>
	</div>
	<handle class="grip" size_target="#document" data-if="sizable"/>
</body>
</template>
