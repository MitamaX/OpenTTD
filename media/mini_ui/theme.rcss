body {
	--panel: #262624f7;
	--panel-edge: #191916;
	--caption: #33332f;
	--tile: #2e2e2b;
	--tile-active: #3d5a5c;
	--tile-ink: #c5c0b2;
	--ink: #d7d2c4;
	--ink-strong: #e6e1d3;
	--ink-soft: #a8a294;
	--ink-muted: #8d8878;
	--ink-dim: #6e6a5e;
	--accent: #8fe0e8;
	--gauge: #e8b94d;
	--veil: #edf2f71c;
	--warn: #e0b64a;
	--warn-ground: #453a1e;
	--warn-ink: #ebd9a8;
	--loss: #e05f4a;
	--loss-ground: #4a2320;
	--loss-ink: #f2d9d2;
	--shadow: #0000008c;
	--radius: 4dp;
	--radius-tile: 3dp;
	--icon: 10dp;
	--hud-margin: 6dp;
	--bar-clearance: 56dp;

	font-family: "Malgun Gothic";
	font-weight: normal;
	font-size: 12dp;
	color: var(--ink);
}

div, handle {
	display: block;
}

.icon {
	width: var(--icon);
	height: var(--icon);
	image-color: var(--ink);
}

[tone=plain] {
	color: var(--ink);
}

[tone=accent] {
	color: var(--accent);
}

[tone=warn] {
	color: var(--warn);
}

[tone=loss] {
	color: var(--loss);
}

[tone=dim] {
	color: var(--ink-dim);
}
