body {
	position: absolute;
	width: 100%;
	height: 100%;
	z-index: 0;
	pointer-events: none;
}

.dock {
	position: absolute;
	display: flex;
	flex-direction: column;
	pointer-events: none;
}

.chrome {
	padding: 6dp;
	background-color: var(--panel);
	decorator: var(--surface);
	border: 1dp var(--panel-edge);
	border-radius: var(--radius);
	box-shadow: var(--float);
	pointer-events: auto;
}

.tile {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	background-color: var(--tile);
	decorator: var(--sheen);
	border: 1dp var(--panel-edge);
	border-radius: var(--radius-tile);
	box-shadow: var(--lift);
	color: var(--tile-ink);
	pointer-events: auto;
}

.tile:hover {
	background-color: var(--tile-hover);
}

.tile:active {
	background-color: var(--tile-press);
}

.tile.active {
	background-color: var(--tile-active);
	color: var(--ink-strong);
	box-shadow: var(--glow);
}

.tile.active:hover {
	background-color: var(--tile-active-hover);
}

.tile .icon {
	image-color: var(--tile-ink);
}

.tile.active .icon {
	image-color: var(--ink-strong);
}

.tile.off {
	opacity: 0.45;
}

.tile.off:hover {
	background-color: var(--tile);
}

.tile-row {
	display: flex;
	gap: var(--tile-gap);
}

.menu-tile {
	flex-direction: column;
	justify-content: flex-start;
	flex-shrink: 0;
	width: var(--tile-size);
	height: var(--tile-size);
	padding: 5dp 2dp 0dp;
}

.art {
	flex-shrink: 0;
	width: var(--art);
	height: var(--art);
	filter: drop-shadow(#00000066 0dp 1dp 1dp);
	transform: scale(1) rotate(0deg);
	transition: transform var(--spring);
}

.tile:hover .art {
	transform: scale(1.14) rotate(-6deg);
}

.tile-label {
	width: 100%;
	margin-top: 2dp;
	overflow: hidden;
	font-size: 10dp;
	line-height: 11dp;
	text-align: center;
}

.shelf {
	display: none;
}

.shelf.open {
	display: flex;
	animation: 0.22s back-out rise-in;
}

.shelf.drop.open {
	animation: 0.22s back-out drop-in;
}

@keyframes drop-in {
	from {
		opacity: 0;
		transform: translateY(-10dp) scale(0.95);
	}
	to {
		opacity: 1;
		transform: translateY(0dp) scale(1);
	}
}

@keyframes rise-in {
	from {
		opacity: 0;
		transform: translateY(10dp) scale(0.95);
	}
	to {
		opacity: 1;
		transform: translateY(0dp) scale(1);
	}
}

.alert {
	padding: 5dp 8dp;
	background-color: var(--warn-ground);
	decorator: var(--sheen);
	border-left: 3dp var(--warn);
	border-radius: var(--radius-chip);
	box-shadow: var(--lift);
	color: var(--warn-ink);
	pointer-events: auto;
	transition: background-color var(--snap);
}

.alert[tone=loss] {
	border-left-color: var(--loss);
	background-color: var(--loss-ground);
	color: var(--loss-ink);
}

.alert-head, .alert-detail {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.alert-detail {
	margin-top: 2dp;
	opacity: 0.7;
}

.toasts {
	position: absolute;
	left: 0dp;
	right: 0dp;
	bottom: 100%;
	margin-bottom: var(--tile-gap);
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 4dp;
}

.toasts .alert {
	width: 340dp;
	max-width: 100%;
}

.dock-left {
	left: var(--hud-margin);
	top: var(--hud-margin);
	align-items: flex-start;
	gap: var(--hud-margin);
}

.colony {
	display: flex;
	flex-direction: column;
	gap: 4dp;
}

.colony-head {
	display: flex;
	align-items: center;
	gap: 6dp;
}

.gauge {
	position: relative;
	flex-shrink: 0;
	width: 30dp;
	height: 30dp;
	border-radius: 15dp;
	background-color: var(--caption);
	box-shadow: #00000059 0dp 1dp 2dp 0dp inset;
}

.gauge-arm {
	position: absolute;
	left: 15dp;
	top: 15dp;
	width: 0dp;
	height: 0dp;
}

.gauge-segment {
	position: absolute;
	left: -1.5dp;
	top: -14dp;
	width: 3dp;
	height: 4dp;
	border-radius: 1dp;
	background-color: var(--tile);
}

.gauge-segment.done {
	background-color: var(--gauge);
}

.colony-title {
	display: flex;
	flex-direction: column;
	gap: 2dp;
	white-space: nowrap;
}

.colony-title div:first-child {
	font-weight: bold;
	color: var(--ink-strong);
}

.colony-funds {
	display: flex;
	column-gap: 12dp;
	white-space: nowrap;
}

.speed {
	width: 22dp;
	height: 16dp;
}

.speed .icon {
	width: 8dp;
	height: 8dp;
}

.status {
	display: flex;
	flex-direction: column;
	gap: 3dp;
}

.status-row {
	position: relative;
}

.status .alert {
	width: 92dp;
}

.status .alert:hover {
	decorator: linear-gradient(var(--veil), var(--veil)), var(--sheen);
}

.names {
	display: none;
	position: absolute;
	left: 100%;
	top: 0dp;
	margin-left: 4dp;
	white-space: nowrap;
}

.names div + div {
	margin-top: 2dp;
}

.status-row:hover .names {
	display: block;
}

.chip {
	padding: 4dp 7dp;
	background-color: var(--panel);
	decorator: var(--sheen);
	border: 1dp var(--panel-edge);
	border-radius: var(--radius-chip);
	box-shadow: var(--lift);
	white-space: pre;
}

.notes {
	left: 0dp;
	top: 0dp;
	right: 0dp;
	bottom: 0dp;
}

.pause-banner {
	position: absolute;
	top: var(--hud-margin);
	left: 50%;
	transform: translateX(-50%);
	color: var(--warn);
	font-weight: bold;
}

.tool-note {
	position: absolute;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 2dp;
}

.option-list {
	flex-direction: column;
	gap: 1dp;
}

.option {
	padding: 3dp 8dp;
	border-radius: var(--radius-chip);
	white-space: pre;
	transition: background-color color var(--snap);
}

.option:hover {
	background-color: var(--tile);
}

.option.active {
	background-color: var(--tile-active);
	decorator: var(--sheen);
	color: var(--ink-strong);
}

.option-head {
	margin: 5dp 4dp 2dp;
	font-size: 10dp;
	color: var(--ink-muted);
}

.dock-bottom {
	left: var(--hud-margin);
	right: var(--hud-margin);
	bottom: var(--hud-margin);
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-end;
}

.corner {
	position: relative;
	display: flex;
	flex-direction: column;
	align-items: flex-end;
}

.stage {
	position: absolute;
	left: 0dp;
	bottom: 100%;
	margin-bottom: var(--tile-gap);
	display: flex;
	align-items: flex-end;
	gap: var(--tile-gap);
}

.stage-end {
	left: auto;
	right: 0dp;
}

.stage-drop {
	top: 100%;
	bottom: auto;
	margin-top: var(--tile-gap);
	margin-bottom: 0dp;
	align-items: flex-start;
}

.dock-right {
	right: var(--hud-margin);
	top: var(--hud-margin);
	align-items: flex-end;
}

.window-base {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	gap: var(--tile-gap);
}

.overlay-strip {
	padding: 4dp;
}

.tool-grid {
	flex-wrap: wrap;
	flex-shrink: 0;
	width: var(--shelf-width);
	gap: var(--tile-gap);
}

.choices {
	flex-direction: column;
	flex-shrink: 0;
	min-width: 120dp;
}

.shelf-title {
	padding: 0dp 4dp 4dp;
	font-weight: bold;
	color: var(--accent);
	white-space: nowrap;
}

.choices .scroll-list {
	max-height: 300dp;
}

.facings {
	margin: 1dp 4dp;
}

.cell {
	width: 26dp;
	height: 26dp;
}

.mark {
	width: 16dp;
	height: 16dp;
}
