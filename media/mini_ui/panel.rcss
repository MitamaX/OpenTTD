body {
	position: absolute;
	display: flex;
	flex-direction: column;
	width: 250dp;
	background-color: var(--panel);
	decorator: var(--surface);
	border: 1dp var(--panel-edge);
	border-radius: var(--radius);
	box-shadow: var(--float);
	animation: 0.22s back-out panel-in;
}

@keyframes panel-in {
	from {
		opacity: 0;
		transform: scale(0.94);
	}
	to {
		opacity: 1;
		transform: scale(1);
	}
}

.caption {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 7dp 8dp 7dp 12dp;
	background-color: var(--caption);
	decorator: var(--sheen);
	border-bottom: 1dp var(--panel-edge);
	border-radius: var(--radius) var(--radius) 0dp 0dp;
}

.title {
	font-size: 13dp;
	font-weight: bold;
	color: var(--accent);
}

.close {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 18dp;
	height: 18dp;
	border-radius: 9dp;
}

.close .icon {
	image-color: var(--ink-muted);
}

.close:hover {
	background-color: var(--loss);
}

.close:hover .icon {
	image-color: var(--ink-strong);
}

.tabs {
	display: flex;
	gap: 3dp;
	padding: 8dp 10dp 0dp;
}

.tab {
	flex: 1;
	padding: 4dp 0dp;
	text-align: center;
	background-color: var(--tile);
	decorator: var(--sheen);
	border: 1dp var(--panel-edge);
	border-radius: var(--radius-chip);
	box-shadow: var(--lift);
	color: var(--tile-ink);
}

.tab:hover {
	background-color: var(--tile-hover);
}

.tab.active {
	background-color: var(--tile-active);
	color: var(--ink-strong);
}

.sheet {
	display: flex;
	flex-direction: column;
	gap: 8dp;
	padding: 10dp 12dp;
}

.section {
	display: flex;
	flex-direction: column;
	gap: 4dp;
}

.heading {
	padding-bottom: 3dp;
	border-bottom: 1dp var(--panel-edge);
	font-weight: bold;
	color: var(--ink-strong);
}

.line {
	display: flex;
	justify-content: space-between;
	column-gap: 14dp;
	color: var(--ink-soft);
}

.line.total {
	padding-top: 3dp;
	border-top: 1dp var(--panel-edge);
	color: var(--ink);
}

.value {
	text-align: right;
}

.commands {
	display: flex;
	flex-wrap: wrap;
	gap: 5dp;
	padding: 8dp 10dp 10dp;
	border-top: 1dp var(--panel-edge);
}

.command {
	padding: 4dp 10dp;
	background-color: var(--primary);
	decorator: var(--sheen);
	border: 1dp var(--panel-edge);
	border-radius: var(--radius-chip);
	box-shadow: var(--lift);
	color: var(--ink-strong);
}

.command:hover {
	background-color: var(--primary-hover);
}

.command:active {
	background-color: var(--primary-press);
}

.command.off, .command.off:hover, .command.off:active {
	background-color: var(--tile);
	color: var(--ink-dim);
}

native-slot, raster-image {
	display: block;
}
