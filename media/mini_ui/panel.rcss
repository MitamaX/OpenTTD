body {
	position: absolute;
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	width: 250dp;
	background-color: var(--panel);
	decorator: var(--surface);
	border: 1dp var(--panel-edge);
	border-radius: var(--radius);
	box-shadow: var(--float);
	animation: 0.22s back-out panel-in;
}

body.wide {
	width: 560dp;
}

@keyframes panel-in {
	from {
		opacity: 0;
		transform: scale(0.94);
	}
	to {
		opacity: 1;
		transform: scale(1);
	}
}

.caption {
	display: flex;
	align-items: center;
	gap: 6dp;
	padding: 7dp 8dp 7dp 12dp;
	background-color: var(--caption);
	decorator: var(--sheen);
	border-bottom: 1dp var(--panel-edge);
	border-radius: var(--radius) var(--radius) 0dp 0dp;
}

.title {
	flex: 1;
	font-size: 13dp;
	font-weight: bold;
	color: var(--accent);
}

.editing .title, .editing .label {
	display: none;
}

.row.active .label, .row.active .value {
	color: var(--ink-strong);
}

.close {
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 18dp;
	height: 18dp;
	border-radius: 9dp;
}

.close .icon {
	image-color: var(--ink-muted);
}

.close:hover {
	background-color: var(--loss);
}

.close:hover .icon {
	image-color: var(--ink-strong);
}

.tabs {
	display: flex;
	gap: 3dp;
	padding: 8dp 10dp 0dp;
}

.tab {
	flex: 1;
	padding: 4dp 0dp;
	text-align: center;
	background-color: var(--tile);
	decorator: var(--sheen);
	border: 1dp var(--panel-edge);
	border-radius: var(--radius-chip);
	box-shadow: var(--lift);
	color: var(--tile-ink);
}

.tab:hover {
	background-color: var(--tile-hover);
}

.tab.active {
	background-color: var(--tile-active);
	color: var(--ink-strong);
}

.sheet {
	display: flex;
	flex-direction: column;
	gap: 8dp;
	padding: 10dp 4dp;
}

.sheet.embedding {
	flex: 1;
	padding: 0dp;
}

.columns {
	display: flex;
	gap: 8dp;
}

.column {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 8dp;
	max-height: 360dp;
}

.camera {
	flex-shrink: 0;
	height: 100dp;
	margin: 0dp 8dp;
}

.embed {
	flex: 1;
}

.grip {
	position: absolute;
	right: 0dp;
	bottom: 0dp;
	width: 12dp;
	height: 12dp;
	decorator: linear-gradient(135deg, #00000000 55%, var(--ink-dim) 55%);
	border-radius: 0dp 0dp var(--radius) 0dp;
}

.grip:hover {
	decorator: linear-gradient(135deg, #00000000 55%, var(--accent) 55%);
}

.section {
	display: flex;
	flex-direction: column;
	gap: 1dp;
}

.heading {
	margin: 0dp 8dp 2dp;
	padding-bottom: 3dp;
	border-bottom: 1dp var(--panel-edge);
	font-weight: bold;
	color: var(--ink-strong);
}

.line {
	display: flex;
	align-items: flex-start;
	column-gap: 14dp;
	color: var(--ink-soft);
}

.line.total {
	margin-top: 2dp;
	border-top: 1dp var(--panel-edge);
	border-radius: 0dp;
	color: var(--ink);
}

.label {
	flex: 1;
	white-space: pre-line;
}

.value {
	flex-shrink: 0;
	text-align: right;
}

.strip {
	flex: 1;
	display: flex;
	gap: 1dp;
	height: 16dp;
	overflow: hidden;
}

.block {
	flex-shrink: 0;
	min-width: 4dp;
	border-radius: 2dp;
	box-shadow: var(--lift);
	transition: opacity var(--snap);
}

.block.engine {
	border-bottom: 3dp var(--accent);
}

.block.active {
	border: 1dp var(--accent);
}

.block:hover {
	opacity: 0.75;
}

.commands {
	display: flex;
	gap: 5dp;
	padding: 8dp 10dp 10dp;
	border-top: 1dp var(--panel-edge);
}

.command {
	flex: 1;
	padding: 4dp 2dp;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	background-color: var(--primary);
	decorator: var(--sheen);
	border: 1dp var(--panel-edge);
	border-radius: var(--radius-chip);
	box-shadow: var(--lift);
	color: var(--ink-strong);
}

.command:hover {
	background-color: var(--primary-hover);
}

.command:active {
	background-color: var(--primary-press);
}

.command.active {
	background-color: var(--tile-active);
	box-shadow: var(--glow);
}

.command.active:hover {
	background-color: var(--tile-active-hover);
}

.command.off, .command.off:hover, .command.off:active {
	background-color: var(--tile);
	color: var(--ink-dim);
}

.map {
	display: flex;
	justify-content: center;
	height: 400dp;
	margin: 0dp 8dp;
}

.map-frame {
	position: relative;
	drag: drag;
}

.map-image {
	width: 100%;
	height: 100%;
}

.map-town {
	position: absolute;
	font-size: 10dp;
	color: var(--ink-strong);
	font-effect: shadow(1dp 1dp #000000c0);
	white-space: nowrap;
	pointer-events: none;
}

.map-town.hidden {
	visibility: hidden;
}

.map-view {
	position: absolute;
	border: 2dp var(--accent);
	pointer-events: none;
}

native-slot, raster-image {
	display: block;
}
