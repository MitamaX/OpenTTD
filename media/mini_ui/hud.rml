<rml>
<head>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="hud.rcss"/>
</head>
<body>
	<map-view id="map" data-model="map" data-event-mousedown="press" data-event-mouseup="release" data-event-dragend="release" data-event-mousemove="move" data-event-mousescroll="zoom"/>
	<div class="dock dock-left">
		<div id="colony" class="chrome colony" data-model="colony">
			<div class="colony-head">
				<div class="gauge">
					<div class="gauge-arm" data-for="segment : gauge" data-style-transform="segment.angle">
						<div class="gauge-segment" data-class-done="segment.done"></div>
					</div>
				</div>
				<div class="colony-title">
					<div data-if="name != ''">{{name}}</div>
					<div>{{date}}</div>
				</div>
			</div>
			<div class="colony-funds" data-if="money != ''" data-attr-tone="funds_tone">
				<span>{{money}}</span>
				<span>{{vehicles}}</span>
				<span data-if="warning != ''">{{warning}}</span>
			</div>
			<div class="tile-row">
				<div class="tile speed press" data-for="speed, index : speeds" data-class-active="speed.active" data-class-off="speed.off" data-event-click="speed(index)">
					<svg class="icon" data-attr-src="speed.icon"/>
				</div>
			</div>
		</div>
		<div id="status" class="status" data-model="status">
			<div class="status-row" data-for="row : rows">
				<div class="alert" data-attr-tone="row.tone" data-event-click="cycle(row.status)">
					<div class="alert-head">{{row.text}}</div>
				</div>
				<div class="chrome names">
					<div data-for="name : row.names">{{name}}</div>
				</div>
			</div>
		</div>
	</div>
	<div class="dock dock-right">
		<div id="windows" class="corner" data-model="windows">
			<div id="window-base" class="window-base">
				<div class="tile-row">
					<div class="tile menu-tile press" data-for="category, index : categories" data-class-active="category.active" data-event-click="toggle(index)">
						<svg class="art" data-attr-src="category.icon"/>
						<div class="tile-label">{{category.label}}</div>
					</div>
				</div>
				<div class="chrome tile-row overlay-strip" data-if="overlays.size > 0">
					<div class="tile cell press" data-for="layer, index : overlays" data-class-active="layer.active" data-event-click="overlay(index)">
						<svg class="mark" data-attr-src="layer.icon"/>
					</div>
				</div>
			</div>
			<div class="stage stage-end stage-drop">
				<div class="chrome shelf drop tool-grid" data-class-open="shelf">
					<div class="tile menu-tile press" data-for="window, index : windows" data-event-click="pick(index)">
						<svg class="art" data-attr-src="window.icon"/>
						<div class="tile-label">{{window.label}}</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="dock dock-bottom">
		<div id="build" class="corner" data-model="build">
			<div class="stage">
				<div class="chrome shelf tool-grid" data-class-open="shelf">
					<div class="tile menu-tile press" data-for="tool, index : tools" data-class-active="tool.active" data-event-click="pick(index)">
						<svg class="art" data-attr-src="tool.icon"/>
						<div class="tile-label">{{tool.label}}</div>
					</div>
				</div>
				<div class="chrome shelf choices" data-class-open="title != ''">
					<div class="shelf-title">{{title}}</div>
					<div id="build-choices" class="scroll-list">
						<div data-for="row : rows">
							<div class="option-head" data-if="row.head">{{row.text}}</div>
							<div data-if="!row.head">
								<div class="tile-row facings" data-if="row.cells.size > 0">
									<div class="tile cell press" data-for="cell : row.cells" data-class-active="cell.active" data-event-click="apply(row.option, cell.value)">
										<svg class="mark" data-attr-src="row.mark" data-style-transform="cell.turn"/>
									</div>
								</div>
								<div class="row link option" data-if="row.cells.size == 0" data-class-active="row.active" data-event-click="apply(row.option, row.value)">{{row.text}}</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="tile-row">
				<div class="tile menu-tile press" data-for="category, index : categories" data-class-active="category.active" data-event-click="toggle(index)">
					<svg class="art" data-attr-src="category.icon"/>
					<div class="tile-label">{{category.label}}</div>
				</div>
			</div>
		</div>
		<div id="toasts" class="toasts" data-model="toasts">
			<div class="alert" data-for="card, index : cards" data-attr-tone="card.tone" data-style-opacity="card.opacity" data-event-click="open(index)">
				<div class="alert-head">{{card.head}}</div>
				<div class="alert-detail" data-if="card.detail != ''">{{card.detail}}</div>
			</div>
		</div>
		<div class="corner">
			<div id="clear" class="stage stage-end" data-model="clear">
				<div class="chrome shelf option-list" data-class-open="shown">
					<div class="row link option" data-for="row, index : rows" data-class-active="row.active" data-event-click="pick(index)">{{row.label}}</div>
				</div>
			</div>
			<div id="commands" class="tile-row" data-model="commands">
				<div class="tile menu-tile press" data-for="command, index : commands" data-class-active="command.active" data-event-click="pick(index)">
					<svg class="art" data-attr-src="command.icon"/>
					<div class="tile-label">{{command.label}}</div>
				</div>
			</div>
		</div>
	</div>
	<div id="notes" class="dock notes" data-model="notes">
		<div class="chip pause-banner" data-if="paused">{{pause_text}}</div>
		<div id="tool-note" class="tool-note" data-if="tool_shown">
			<div class="chip">{{title}}</div>
			<div class="chip">{{hint}}</div>
			<div class="chip" data-if="cost != ''" data-attr-tone="cost_tone">{{cost}}</div>
		</div>
	</div>
</body>
</rml>
